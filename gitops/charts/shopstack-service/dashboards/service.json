{
  "uid": "shopstack-service",
  "title": "ShopStack · Service",
  "tags": ["shopstack", "service", "red"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(shopstack_http_requests_total, service)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(shopstack_http_requests_total{service=\"$service\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by status class",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(shopstack_http_requests_total{service=\"$service\",namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 12, "lineWidth": 2, "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error ratio (5xx)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(shopstack_http_requests_total{service=\"$service\",namespace=~\"$namespace\",status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(shopstack_http_requests_total{service=\"$service\",namespace=~\"$namespace\"}[5m])), 0.0001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.005 },
            { "color": "red", "value": 0.01 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shopstack_http_request_duration_seconds_bucket{service=\"$service\",namespace=~\"$namespace\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.3 },
            { "color": "red", "value": 0.5 }
          ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(shopstack_http_request_duration_seconds_bucket{service=\"$service\",namespace=~\"$namespace\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(shopstack_http_request_duration_seconds_bucket{service=\"$service\",namespace=~\"$namespace\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(shopstack_http_request_duration_seconds_bucket{service=\"$service\",namespace=~\"$namespace\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "In-flight requests & replicas",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(shopstack_http_requests_in_flight{service=\"$service\",namespace=~\"$namespace\"})", "legendFormat": "in flight" },
        { "refId": "B", "expr": "count(kube_pod_info{namespace=~\"$namespace\",pod=~\"$service.*\"})", "legendFormat": "pods" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Slowest routes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (route, le) (rate(shopstack_http_request_duration_seconds_bucket{service=\"$service\",namespace=~\"$namespace\"}[5m]))))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "route": "Route", "Value": "p95 (s)" } } }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dependency health",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "min by (dependency) (shopstack_dependency_up{service=\"$service\",namespace=~\"$namespace\"})", "legendFormat": "{{dependency}}" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Rollouts",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "expr": "changes(kube_pod_created{namespace=~\"$namespace\",pod=~\"$service.*\"}[5m]) > 0",
        "iconColor": "blue",
        "title": "Deployment changed"
      }
    ]
  }
}
