{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "shopstack-service values",
  "type": "object",
  "required": ["global", "image", "workload"],
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "imageRegistry"],
      "properties": {
        "environment": { "type": "string", "enum": ["dev", "qa", "staging", "prod"] },
        "imageRegistry": { "type": "string", "minLength": 1 }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["Deployment", "Rollout"] },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string", "enum": ["canary", "blueGreen"] },
        "canary": {
          "type": "object",
          "properties": {
            "steps": { "type": "array" },
            "maxSurge": { "type": ["string", "integer"] },
            "maxUnavailable": { "type": ["string", "integer"] }
          }
        }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "config": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "secrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "remoteRef"],
            "properties": {
              "name": { "type": "string" },
              "remoteRef": {
                "type": "object",
                "required": ["key"],
                "properties": { "key": { "type": "string" }, "property": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": { "runAsNonRoot": { "type": "boolean" } }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "startup": { "$ref": "#/definitions/probe" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": ["integer", "string"] } }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "interval": { "type": "string" } }
        },
        "canaryServiceMonitor": { "type": "boolean" },
        "dashboard": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "analysis": {
      "type": "object",
      "required": ["prometheusAddress"],
      "properties": {
        "prometheusAddress": { "type": "string" },
        "canaryOnly": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" }
      }
    }
  }
}
