        },
        "definition": "label_values(shopstack_http_requests_total, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": "label_values(shopstack_http_requests_total, namespace)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "timezone": "browser",
  "title": "ShopStack \u00b7 Progressive Delivery",
  "uid": "shopstack-progressive-delivery",
  "version": 1,
  "description": "Canary vs stable for every ShopStack rollout: traffic split, error ratio, latency and analysis signals.",
